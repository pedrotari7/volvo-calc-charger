{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"main": "lib/backend/src/index.js",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"lint": "eslint . --ext .ts",
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"test": "vitest run --config vitest.config.ts",
		"allow": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/allow.ts",
		"seed": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/seed.ts",
		"capture-volvo": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/captureVolvo.ts"
	},
	"dependencies": {
		"firebase-admin": "13.10.0",
		"firebase-functions": "7.2.5"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@typescript-eslint/eslint-plugin": "8.60.0",
		"@typescript-eslint/parser": "8.60.0",
		"eslint": "8.57.1",
		"ts-node": "10.9.2",
		"typescript": "5.9.3"
	}
}
